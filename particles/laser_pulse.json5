// Native T0 package (MOD-FORMAT-SPEC.md). Hand edits are legal — re-run the
// fidelity gate if you intend to stay byte-compatible with the WL original.
{
  "legacy": {
    "part_trail_type_unused": 1
  },
  "physics": {
    "gravity": 0.001,
    "damping": 1,
    "wobble": 0.001,
    "pushed_by_blasts": true,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 255
  },
  "radius": 2,
  "collide": {
    "terrain": true,
    "worms": true,
    "projectiles": true
  },
  "fuse": {
    "ticks": 0,
    "variance": 0
  },
  "on": {
    "fuse": [
      "bullet_impact",
      {
        "emit": {
          "type": "ricochet",
          "count": 5,
          "velocity": "radial",
          "wl_free_step": true
        }
      },
      {
        "explo_sound": {}
      }
    ],
    "collide_terrain": [
      "bullet_impact",
      {
        "emit": {
          "type": "ricochet",
          "count": 5,
          "velocity": "radial",
          "wl_free_step": true
        }
      },
      {
        "explo_sound": {}
      },
      {
        "remove": {}
      }
    ],
    "collide_worm": [
      {
        "damage_other": {
          "amount": 16
        }
      },
      {
        "push_other": {
          "factor": 0
        }
      },
      {
        "emit": {
          "type": "core:blood",
          "count": 1
        }
      },
      {
        "emit": {
          "type": "ricochet",
          "count": 5,
          "velocity": "radial",
          "wl_free_step": true
        }
      },
      {
        "remove": {}
      }
    ]
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  // The beam is FIRST-CLASS now (2026-07-25). Liero had no way to texture a
  // laser, so the WL original faked one: `on.tick {every: 1, unit:
  // "wl_tick_burst", do: ["smoke_puff"]}` dropped a smoke_puff effect at
  // EVERY substep — up to 255 sObjects (each with its own light) per shot,
  // just to paint a dotted yellow line. That is now one `presentation.line`
  // quad along the bullet's spawn-tick segment, the same mechanism
  // dark/PowerEternal's `emitcharge` uses. The texture reproduces the old
  // look deliberately: gold filament, ~3px dot rhythm (the old substep
  // spacing), white sparks. `scroll` decorrelates the pattern between shots,
  // so a burst crackles instead of stamping the same beam five times.
  // Gameplay delta: the puffs also carried damage {r: 2, amount: 1}, so a
  // near-miss no longer grazes for a point or two — the 16-damage direct hit
  // is unchanged.
  "presentation": {
    "color_index": 161,
    "splinter_color_index": 75,
    "sprite_wl": {
      "start": -1
    },
    "line": {
      "texture": "excimer_beam",
      "color": "#ffffff",
      "width": 5,
      "length": 96,
      "scroll": 7000,
      "lit": false,
      "blend": "auto"
    },
    // Replaces the glow the 255 puff lights used to stack along the path
    // (each rgb [1, 1, 0.6046] i0.0361 r12). A line-presented light washes
    // down the whole segment as one emissive quad plus a hot spot at the
    // impact, so this is one light def, not a swarm.
    "light": {
      "rgb": [
        1,
        0.96,
        0.55
      ],
      "intensity": 0.7,
      "radius": 16
    }
  },
  // Excimer burn (2026-07-30): a 2px scorch ring around the beam's terminus.
  // The def's own terrain list, stamped once at the death position — NOT
  // along the path. Scorching the whole beam would need an on.tick effect
  // firing per movement step, which at substeps 255 is exactly the 255
  // sObjects the `line` presentation above was written to delete.
  //
  // An ANNULUS, and it has to be. This def's bands stamp before the death
  // effects', and `bullet_impact` carves r 4 — so a disc inside that radius
  // is deleted by the crater a few microseconds after it is written, every
  // shot, forever. Measured as exactly that: 40 held shots, 250 timber cells
  // drilled, zero ignitions. Starting at 4 puts the heat where the wood
  // still is.
  //
  // The 80 limit is core:wood's ignition point exactly, and that is the
  // whole design: an excimer can light wood (and oil at 60, and jungle
  // tinder at 45) and can do literally nothing else to terrain — 80 is far
  // under the lowest melting point in the engine (core:sand, 200). Ignition
  // tests `>=`, so landing exactly on 80 is a hit, not a near miss.
  //
  // The amount is the scorch tier's, not something smaller, because the beam
  // is a MOVING target: it drills ~4px a shot, so the ring lands on fresh
  // wood each time and few cells collect more than two or three stamps
  // before the hole is through and the terminus drops out of the timber
  // entirely. +12 (four stamps to reach 80) never ignited anything in 40
  // held shots; +25 lights the first cells on the second shot and settles
  // into a ~60-cell smoulder, which is the intended weak-but-real effect.
  // +40 was tried and flashes the whole structure — too strong for a laser.
  "terrain": [
    {
      "modify_temperature": {
        "r": [
          4,
          6
        ],
        "amount": 25,
        "limit": 80
      }
    }
  ],
  "speed": 3
}
