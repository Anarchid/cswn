// BADGER carrier — the vestigial particle phase of the thrown keg. It exists
// only to reach `spawn_body`, which no weapon `on.fire` list can call itself
// (§11: on.fire executes `emit` and nothing else), so the shortest legal
// handoff is a particle that fuses immediately.
//
// `fuse.ticks: 1` IS that immediacy: a wObject-class def expires on
// `time_alive > timeout`, so 1 is the shortest expressible fuse and the keg
// becomes a `badger_barrel` two ticks out of the muzzle. Nothing keeps it out
// of the firing worm during those two ticks except the weapon's `offset: 9`
// — see weapons/w122_badger.json5. `velocity: "inherit"` carries the throw
// across the handoff; with the weapon's `speed: 0, inherit: 1` that throw IS
// the worm's own velocity, so a standing worm hands over a body at rest (the
// spawn leaves it asleep) and a running one hands over a moving keg.
// `on.settle` is the same handoff for a keg fired point-blank into terrain,
// which parks before the fuse reaches it.
//
// The long random detonation fuse and the acid burst live on the barrel body
// (bodies/badger_barrel.json5), which can also be shot to detonate early.
// Physics/sprite below still match the old WL badger — two ticks of it are
// visible — and the carrier's owner/weapon ride the spawn, so a keg you
// threw credits YOU when it crushes someone.
{
  "legacy": {
    "obj_trail_delay_unused": 1
  },
  "physics": {
    "gravity": 0.032,
    "damping": 1,
    "wobble": 0,
    "pushed_by_blasts": false,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1,
    "bounce": {
      "restitution": 0.5,
      "friction": 0.8
    }
  },
  "radius": 0,
  "collide": {
    "terrain": true,
    "worms": true,
    "projectiles": false
  },
  "fuse": {
    "ticks": 2,
    "variance": 0
  },
  "on": {
    "settle": [
      { "spawn_body": { "body": "badger_barrel", "velocity": "inherit" } },
      { "remove": {} }
    ],
    "fuse": [
      { "spawn_body": { "body": "badger_barrel", "velocity": "inherit" } },
      { "remove": {} }
    ],
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  "presentation": {
    "color_index": 162,
    "splinter_color_index": 11,
    "sprite_wl": {
      "start": 516
    },
    "sprite": "s516_1",
  },
  "speed": 2.22
}
