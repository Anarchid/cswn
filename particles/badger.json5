// BADGER carrier — the thrown keg in flight. It travels, bounces, and comes
// to rest, then SPAWNS the `badger_barrel` rigid body in its place and
// vanishes (on.settle). The long random detonation fuse and the acid burst
// now live on the barrel body (bodies/badger_barrel.json5), which can also be
// shot to detonate early. Physics/sprite/trail below match the old WL badger
// so the flight looks identical.
{
  "legacy": {
    "obj_trail_delay_unused": 1
  },
  "physics": {
    "gravity": 0.032,
    "damping": 1,
    "wobble": 0,
    "pushed_by_blasts": false,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1,
    "bounce": {
      "restitution": 0.5,
      "friction": 0.8
    }
  },
  "radius": 0,
  "collide": {
    "terrain": true,
    "worms": true,
    "projectiles": false
  },
  "fuse": {
    "ticks": 90,
    "variance": 0
  },
  "on": {
    "settle": [
      { "spawn_body": { "body": "badger_barrel" } },
      { "remove": {} }
    ],
    "fuse": [
      { "spawn_body": { "body": "badger_barrel" } },
      { "remove": {} }
    ],
    "collide_worm": [
      {
        "damage_other": {
          "amount": 0
        }
      },
      {
        "push_other": {
          "factor": 0
        }
      }
    ],
    "tick": [
      {
        "every": 8,
        "unit": "wl_tick_burst",
        "do": [
          {"emit": {"type": "badger_trail"}},
        ]
      }
    ]
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  "presentation": {
    "color_index": 162,
    "splinter_color_index": 11,
    "sounds": {
      "explode": "exp5.wav"
    },
    "sprite_wl": {
      "start": 516
    },
    "sprite": "s516_1",
    "light": {
      "rgb": [0,1,0],
      "intensity": 0.2,
      "radius": 160
    }
  },
  "speed": 2.22
}
