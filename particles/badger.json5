// BADGER carrier — the thrown keg's first half-second of flight. It travels as
// a particle, then its 30-tick fuse hands the throw to the `badger_barrel`
// rigid body (`velocity: "inherit"` — without it the keg would materialize
// mid-arc with no momentum and drop straight down) and vanishes; on.settle is
// the same handoff for when it lands first. The long random
// detonation fuse and the acid burst live on the barrel body
// (bodies/badger_barrel.json5), which can also be shot to detonate early.
// Physics/sprite/trail below match the old WL badger so the launch looks
// identical, and the carrier's owner/weapon ride the spawn — a keg you threw
// credits YOU when it crushes someone.
{
  "legacy": {
    "obj_trail_delay_unused": 1
  },
  "physics": {
    "gravity": 0.032,
    "damping": 1,
    "wobble": 0,
    "pushed_by_blasts": false,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1,
    "bounce": {
      "restitution": 0.5,
      "friction": 0.8
    }
  },
  "radius": 0,
  "collide": {
    "terrain": true,
    "worms": true,
    "projectiles": false
  },
  "fuse": {
    "ticks": 30,
    "variance": 0
  },
  "on": {
    "settle": [
      { "spawn_body": { "body": "badger_barrel", "velocity": "inherit" } },
      { "remove": {} }
    ],
    "fuse": [
      { "spawn_body": { "body": "badger_barrel", "velocity": "inherit" } },
      { "remove": {} }
    ],
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  "presentation": {
    "color_index": 162,
    "splinter_color_index": 11,
    "sprite_wl": {
      "start": 516
    },
    "sprite": "s516_1",
  },
  "speed": 2.22
}
