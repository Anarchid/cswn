// FORCE FIELD deployment pod — the throw, and nothing else.
//
// This def used to BE the field: a weightless cell that coasted to a halt in
// mid-air on `damping: 0.93` and then dripped a `force_field_spark` downward
// every three ticks forever, the drips falling under their own gravity into a
// curtain. The emitter is a rigid body now
// (`bodies/force_field_emitter.json5`) and the curtain is a laser, so this is
// reduced to what a weapon can actually reach: `on.fire` executes `emit` and
// nothing else, so a body needs a carrier to route through.
//
// The flight profile is the original's, unchanged — same launch speed, same
// 0.93 damping — because where the pod ENDS UP is the whole feel of the
// weapon: about 46px along your aim, hanging in the air where you left it.
// `fuse: 22` is where that coast has spent 80% of its speed, so the emitter
// materialises very nearly at rest and its own drag finishes the job.
//
// It bounces now, where the original stopped dead. The emitter is 18x12 of
// solid body, and a carrier that parks flush against a wall would unfold it
// half inside the rock, which is how a fresh body catches the depenetration
// ejection and gets thrown across the room. A rebound costs nothing and puts
// the pod in open air.
{
  "physics": {
    "gravity": 0,
    "damping": 0.93,
    "wobble": 0,
    "pushed_by_blasts": true,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1,
    "bounce": {
      "restitution": 0.4,
      "friction": 0.8
    }
  },
  "radius": 2,
  "collide": {
    "terrain": true,
    "worms": false,
    "projectiles": false
  },
  "fuse": {
    "ticks": 22,
    "variance": 0
  },
  "on": {
    // Unfold. No `rotation: "inherit"` — the emitter is `fixed_rotation` and
    // fires straight down on an absolute bearing, so handing it the throw
    // heading would only tilt the art away from the beam it emits.
    "fuse": [
      {
        "spawn_body": {
          "body": "force_field_emitter",
          "velocity": "inherit"
        }
      },
      { "sound": "energy_reload.ogg" },
      { "remove": {} }
    ]
  },
  "anim": {
    "frames": 0
  },
  // The pod, drawn with the body's own pixels.
  //
  // This carrier used to draw nothing (`start: -1`, inherited from the WL cell,
  // which was invisible because its DRIPS were the throw's feedback and they
  // began three ticks in). A body that unfolds at the end of the coast has no
  // such cover: the 22 ticks below were a third of a second of empty screen
  // followed by a pod that appeared to teleport into place.
  //
  // `force_field_pod` is byte-identical to the emitter's stain and its origin
  // is the negated COM, so the sprite and the body occupy exactly the same
  // pixels — the handover is invisible because there is nothing to hand over.
  // The light matches the body's for the same reason. The emitter is
  // `fixed_rotation`, so a still sprite is the whole of its pose.
  "presentation": {
    "color_index": 0,
    "splinter_color_index": 24,
    "sprite_wl": {
      "start": 0,
      "draw_on_map": false
    },
    "sprite": "force_field_pod",
    "light": {
      "color": "#7ad945",
      "intensity": 0.7,
      "radius": 26
    }
  },
  "speed": 3.7
}
