// DOBERMAN UAV9/DR launch carrier — the throw, and nothing else.
//
// This def used to BE the drone: a WL shotType-2 steerable that flew where its
// owner aimed, thrust on Up and strafed every 88 ticks. The drone is a rigid
// body now (`bodies/doberman_uav.json5`), for the reason every dark-map weapon
// eventually wants — a body draws itself as its own quad and can say
// `lit: false`, so the UAV is visible in an unlit room, where a lit sprite
// simply was not.
//
// `spawn_body` is unreachable from a weapon (`on.fire` executes `emit` and
// nothing else), so the body needs a carrier to route through. This is it:
// four ticks of flight and a handover.
//
// Four ticks, and the number is measured rather than picked. The muzzle sits
// `radius + 5` = 7px out, the carrier covers 3px/tick, and the drone's own
// half-diagonal is 6.5px (7x11 bitmap) — so at four ticks the hull's nearest
// corner clears the firing worm by about 5px. Any fewer and the UAV
// materialises overlapping its own pilot, which is how a fresh body catches
// the depenetration ejection and gets flung.
//
// It bounces, inheriting the original drone's `restitution: 1`, and that is
// what keeps the shot honest against a wall: fire at a rock face point-blank
// and the carrier rebounds into open air instead of unfolding a solid body
// inside the rock.
//
// Invisible on purpose. The drone sprite is SIXTEEN directional frames and
// this def is not directional (no `pilot`/`steer`, so shotType 4 draws frame 0
// forever) — four frames of a drone facing hard up while it flies sideways
// reads worse than four frames of nothing.
{
  "legacy": {
    "splinter_scatter_unused": 1
  },
  "physics": {
    "gravity": 0,
    "damping": 1,
    "wobble": 0,
    "pushed_by_blasts": false,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1,
    "bounce": {
      "restitution": 1,
      "friction": 1
    }
  },
  "radius": 2,
  "collide": {
    "terrain": true,
    "worms": false,
    "projectiles": false
  },
  "fuse": {
    "ticks": 4,
    "variance": 0
  },
  "on": {
    // Unfold. `rotation: "inherit"` in a PARTICLE list spawns the body facing
    // the trigger's HEADING, so the UAV's nose — its local +x, and its bore —
    // points exactly where the shot was aimed. `velocity: "inherit"` hands it
    // the throw, which its own `drag` then bleeds off over about a second.
    "fuse": [
      {
        "spawn_body": {
          "body": "doberman_uav",
          "velocity": "inherit",
          "rotation": "inherit"
        }
      },
      { "sound": "sight_on.ogg" },
      { "remove": {} }
    ]
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  "presentation": {
    "color_index": 161,
    "splinter_color_index": 162,
    "sprite_wl": {
      "start": -1
    }
  },
  "speed": 3
}
