  "fuse": {
    "ticks": 15,
    "variance": 1
  },
  "on": {
    "fuse": [
      // Burned out in mid-air: leave one pixel of real fire behind. In an
      // `on.*` list `place` is the EventAction form (scalar r) — it nudges
      // to the nearest free cell and only writes into non-solid, so a flame
      // expiring against a wall drops its ember beside the wall, not inside
      // it. `core:fire` arrives at its own spawn_temp (180).
      {
        "place": {
          "r": 0,
          "material": "core:flame"
        }
      }
    ],
    "collide_terrain": [
      {
        "remove": {}
      }
    ],
    "collide_worm": [
      {
        "damage_other": {
          "amount": 4
        }
      },
      {
        "push_other": {
          "factor": 0
        }
      },
      {
        "emit": {
          "type": "core:blood",
          "count": 3
        }
      },
      {
        "remove": {}
      }
    ]
  },
  "anim": {
    "frames": 3
  },
  "presentation": {
