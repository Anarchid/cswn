  "terrain": [
    {
      "carve": {
        "r": [
          0,
          4
        ]
      }
    },
    // Wider than the carve above it ON PURPOSE. Bands run in list order and
    // each sees the world the previous one left, so a heat disc the same size
    // as the carve lands entirely inside the hole it just made — and `carve`
    // takes exactly the DESTRUCTIBLE cells, which is exactly the fuel. r 6
    // over a carve of 4 leaves a 2px heated rim that is still there to burn.
    {
      "modify_temperature": {
        "r": [
          0,
          6
        ],
        "amount": 25,
        "limit": 150
