// GADGET carrier — the vestigial particle phase of the placed mine. It exists
// only to reach `spawn_body`, which no weapon `on.fire` list can call itself
// (§11: on.fire executes `emit` and nothing else), so the shortest legal
// handoff is a particle that fuses immediately.
//
// `fuse.ticks: 1` IS that immediacy: a wObject-class def expires on
// `time_alive > timeout`, so 1 is the shortest expressible fuse and the mine
// becomes a `gadget_mine` two ticks out of the muzzle. Nothing keeps it out
// of the firing worm during those two ticks except the weapon's `offset: 9`
// — see weapons/w116_gadget.json5. `velocity: "inherit"` carries the throw
// across the handoff; with the weapon's `speed: 0, inherit: 1` that throw IS
// the worm's own velocity, so a standing worm sets down a body at rest (the
// spawn leaves it asleep) and a running one skids it along. `on.settle` is
// the same handoff for a mine fired point-blank into terrain, which parks
// before the fuse reaches it.
//
// The carrier's owner/weapon ride the spawn, so the nuke credits whoever
// placed it.
//
// Everything that used to live on the `gadget_core` particle now lives on
// TWO bodies (which is why `gadget_core` no longer exists):
// bodies/gadget_mine.json5 is the unarmed grace phase (the WL original's
// 180 carrier ticks, restored), and it morphs into
// bodies/gadget_mine_armed.json5 — the 1620-tick nuke fuse and the
// worm-contact defuse.
{
  "legacy": {
    "obj_trail_delay_unused": 1
  },
  "physics": {
    "gravity": 0.032,
    "damping": 1,
    "wobble": 0,
    "pushed_by_blasts": false,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1
  },
  "radius": 0,
  "collide": {
    "terrain": true,
    "worms": true,
    "projectiles": false
  },
  "fuse": {
    "ticks": 2,
    "variance": 0
  },
  "on": {
    "settle": [
      { "spawn_body": { "body": "gadget_mine", "velocity": "inherit" } },
      { "remove": {} }
    ],
    "fuse": [
      { "spawn_body": { "body": "gadget_mine", "velocity": "inherit" } },
      { "remove": {} }
    ]
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  "presentation": {
    "lit":false,
    "color_index": 162,
    "splinter_color_index": 11,
    "sprite_wl": {
      "start": 588
    },
    "sprite": "s588_1"
  },
  "speed": 2.22
}
