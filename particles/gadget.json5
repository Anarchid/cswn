// GADGET carrier — the thrown mine's flight. It travels as a particle with
// the WL gadget's exact physics and sprite, then hands itself off to the
// `gadget_mine` rigid body: on `settle` the moment it comes to rest, and on
// its 180-tick fuse as the fallback for a throw that never settles cleanly
// (a mine fired into the ground can wedge at the muzzle with no settle edge).
// `velocity: "inherit"` carries the throw across the handoff — without it the
// mine would materialize mid-arc at rest and drop straight down — and the
// carrier's owner/weapon ride the spawn, so the nuke credits whoever threw it.
//
// Everything that used to live on the `gadget_core` particle (the 1620-tick
// nuke fuse, the worm-contact reaction) now lives on the body
// (bodies/gadget_mine.json5), which is why `gadget_core` no longer exists.
{
  "legacy": {
    "obj_trail_delay_unused": 1
  },
  "physics": {
    "gravity": 0.032,
    "damping": 1,
    "wobble": 0,
    "pushed_by_blasts": false,
    "impulse_mass": 4,
    "ccd": false,
    "substeps": 1
  },
  "radius": 0,
  "collide": {
    "terrain": true,
    "worms": true,
    "projectiles": false
  },
  "fuse": {
    "ticks": 180,
    "variance": 0
  },
  "on": {
    "settle": [
      { "spawn_body": { "body": "gadget_mine", "velocity": "inherit" } },
      { "remove": {} }
    ],
    "fuse": [
      { "spawn_body": { "body": "gadget_mine", "velocity": "inherit" } },
      { "remove": {} }
    ]
  },
  "anim": {
    "frames": 0,
    "mode": "by_velocity"
  },
  "presentation": {
    "lit":false,
    "color_index": 162,
    "splinter_color_index": 11,
    "sprite_wl": {
      "start": 588
    },
    "sprite": "s588_1"
  },
  "speed": 2.22
}
