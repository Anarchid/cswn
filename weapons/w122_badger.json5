// Generated by the WebNoita T1 converter from csliero-webnoita/mod.json5.
// Native T0 package (MOD-FORMAT-SPEC.md). Hand edits are legal — re-run the
// fidelity gate if you intend to stay byte-compatible with the WL original.
{
  "ammo": 1,
  "reload": 65535,
  "fire_delay": 60,
  "recoil": 0,
  // A PLACED keg, not a thrown one — WL `bulletSpeed: 0`, restored. The keg
  // leaves the worm with no muzzle speed of its own and exactly the worm's
  // velocity (`inherit: 1`), so a standing worm sets down a keg that sits
  // still and a running one lobs it along. The `speed: 1` this used to carry
  // was a converter fossil (the old `||` fallback turned WL's 0 into 1), and
  // the rigidization then handed that phantom muzzle speed to the body.
  //
  // `offset: 9` puts the spawn 14 px out (5 px base muzzle + 9): the barrel
  // is 10×11 around its COM and the worm's body-contact box reaches ±4 px
  // wide and 6 px up, so 14 px clears the keg of its thrower at every aim
  // angle including the 45° diagonals. The carrier hands off to the body
  // two ticks later (particles/badger.json5) and this offset is the ONLY
  // thing keeping that body out of the firing worm.
  "on": {
    "fire": [
      {
        "emit": {
          "type": "badger",
          "count": 1,
          "speed": 0,
          "jitter": 0,
          "inherit": 1,
          "offset": 9
        }
      }
    ],
    "dryfire": [
      { "emit": { "type": "snd_dryfire_heavy", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ]
  },
  "beam": false,
  "presentation": {
    "name": "BADGER",
    "laser_sight": false,
    "sounds": {
      "fire": "alive.wav"
    },
    "fire_cone": -1,
    "shells": {
      "leave": 0,
      "delay": 1
    }
  },
  "legacy": {
    "wl_weapon_distribution": 0.030517578125
  }
}
