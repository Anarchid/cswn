// Generated by the WebNoita T1 converter from csliero-webnoita/mod.json5.
// Native T0 package (MOD-FORMAT-SPEC.md). Hand edits are legal — re-run the
// fidelity gate if you intend to stay byte-compatible with the WL original.
{
  "ammo": 120,
  "reload": 250,
  "fire_delay": 1,
  "recoil": 0,
  "on": {
    "fire": [
      {
        "emit": {
          "type": "super_m9a1_flame",
          "count": 5,
          "speed": 5.4,
          "jitter": 1.052,
          "inherit": 0.294
        }
      },
      // The roar. `fire_delay: 1` means this list runs every tick, which is
      // why the carrier's sound verb declares a cooldown instead of playing
      // sixty times a second — see particles/snd_flamer_loop.json5.
      { "emit": { "type": "snd_flamer_loop", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ],
    "dryfire": [
      { "emit": { "type": "snd_dryfire_heavy", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ],
    "selected": [
      { "emit": { "type": "snd_flamer_select", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ],
    // The pilot light, one per tick for as long as the gun is in hand. Costs
    // the sim nothing at all: flamer_pilot is R11-demoted, so this never
    // reaches the world and never draws world RNG (which is also what makes
    // the jitter free — the fx pool rolls it client-side).
    "while_selected": [
      // `offset` pulls the flame back off the 8 px muzzle (flamer_pilot's
      // radius 3, plus the engine's constant 5) so it burns at the barrel
      // root instead of hanging past the tip. Needs webnoita 3ee3810 or
      // newer: before that the R11 fx path dropped the field, whatever its
      // sign, so on an older engine this reads as 8 px and looks detached.
      { "emit": { "type": "flamer_pilot", "count": 1, "speed": 1, "jitter": 0.25, "inherit": 0, "offset": -3 } }
    ]
  },
  "beam": false,
  "presentation": {
    "name": "M9A1-7 FLAMETHROWER",
    "laser_sight": false,
    "fire_cone": 0,
    "shells": {
      "leave": 0,
      "delay": 1
    }
  },
  "legacy": {
    "wl_weapon_distribution": 0.30517578125
  }
}
