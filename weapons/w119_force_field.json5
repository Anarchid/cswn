// FORCE FIELD — the launcher.
//
// Was: converted from csliero-webnoita/mod.json5 by the T1 converter. Now
// hand-edited (2026-08-19). The weapon is untouched — same ammo, same 75-frame
// delay, same single 4.2 throw — because everything that changed is downstream:
// `force_field_cell` is a deployment pod that unfolds into a rigid emitter
// (`bodies/force_field_emitter.json5`) after 22 ticks of coasting, and the
// curtain of falling sparks is a 290px scrolling laser.
//
// `ammo: 1` + `reload: 65535` = one per pickup, no reload. Unlike DOBERMAN
// nothing here reads the held weapon: a deployed field runs on its own and
// keeps running whether or not the thrower is alive.
{
  "ammo": 1,
  "reload": 65535,
  "fire_delay": 75,
  "recoil": 0,
  "on": {
    "fire": [
      {
        "emit": {
          "type": "force_field_cell",
          "count": 1,
          "speed": 4.2,
          "jitter": 0,
          "inherit": 0
        }
      }
    ],
    "dryfire": [
      { "emit": { "type": "snd_dryfire_pistol", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ],
    "selected": [
      { "emit": { "type": "snd_sight_on", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ]
  },
  "beam": false,
  "presentation": {
    "name": "FORCE FIELD",
    "laser_sight": false,
    "sounds": {
      "fire": "throw.wav"
    },
    "fire_cone": 0,
    "shells": {
      "leave": 0,
      "delay": 1
    }
  }
}
