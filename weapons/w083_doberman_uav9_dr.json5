// DOBERMAN UAV9/DR — the launcher.
//
// Was: converted from csliero-webnoita/mod.json5 by the T1 converter. Now
// hand-edited (2026-08-19), and the weapon itself is the part that changed
// LEAST: same ammo, same delay, same recoil, same two emits. What it throws is
// a carrier now (`particles/doberman_drone.json5`), because `on.fire` executes
// `emit` and nothing else and the drone became a rigid body four ticks
// downrange.
//
// `ammo: 1` + `reload: 65535` (u16 max, ~18 min) is what makes the whole
// weapon work: the §13.3 control gate asks whether the pilot is HOLDING this
// weapon type, not whether it has ammo, so an empty launcher still flies the
// drone. Draw something else and the UAV parks itself in mid-air, still yours;
// draw the launcher again and you have it back.
{
  "ammo": 1,
  "reload": 65535,
  "fire_delay": 44,
  "recoil": 0.05,
  "on": {
    "fire": [
      {
        "emit": {
          "type": "doberman_drone",
          "count": 1,
          "speed": 3,
          "jitter": 0,
          "inherit": 0
        }
      },
      {
        "emit": {
          "type": "muzzle_flash_01",
          "count": 1,
          "speed": 0.08,
          "jitter": 0,
          "inherit": 0
        }
      }
    ],
    "dryfire": [
      { "emit": { "type": "snd_dryfire_heavy", "count": 1, "speed": 0, "jitter": 0, "inherit": 0 } }
    ]
  },
  "beam": false,
  "presentation": {
    "name": "DOBERMAN UAV9/DR",
    "laser_sight": false,
    "sounds": {
      "fire": "throw.wav"
    },
    "fire_cone": -1,
    "shells": {
      "leave": 0,
      "delay": 1
    }
  },
  "legacy": {
    "wl_weapon_distribution": 0.1068115234375
  }
}
