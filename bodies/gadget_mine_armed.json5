// GADGET mine, ARMED — what the unarmed mine morphs into when its 180-tick
// grace expires (see bodies/gadget_mine.json5 for the two-phase story).
// This is the original rigidized mine, verbatim, plus the arming tell: the
// blueprint is in LITERAL-id mode (no `material:` key, bytes ARE material
// ids), casing 13 = core:metal, and the 13 trefoil pixels are
// materials/trefoil.json5 (id 255) — metal in every SIM respect, but
// faintly emissive, so an armed mine shows its warning pips in the dark.
// The stain still paints the same casing art over the top.
//
// Three ways it ends, and only one of them is loud:
//   worm contact  → `destroy_self`: it crumbles into a shower of its own
//                   pixels (the trefoil ones land as briefly-glowing
//                   embers). Touching the ARMED mine DEFUSES it — the one
//                   way to save the map, and it costs you walking into the
//                   thing. During the grace period touch does nothing;
//                   that's the point of the grace period.
//   fuse (1620t)  → the full nuke chain: gadget_explosion, then the
//                   gadget_detonator → shatter → melt → 255 fireball
//                   cascade that kills every worm on the map. 180 + 1620 =
//                   the original's 1800-tick doomsday clock.
//   projectiles   → nothing. `hp` is omitted, so the engine makes it
//                   INDESTRUCTIBLE: shots and blasts shove the casing
//                   around (mass 20 against ordnance's impulse_mass) but
//                   can never end it. You can kick it toward someone; you
//                   cannot disarm it from range.
{
  "shape": {
    "blueprint": {
      "w": 9,
      "h": 9,
      "ids": [
        13, 13, 13, 13, 13, 13, 13, 13, 13,
        13, 13, 255, 13, 13, 13, 255, 13, 13,
        13, 255, 255, 255, 13, 255, 255, 255, 13,
        13, 13, 13, 13, 13, 13, 13, 13, 13,
        13, 13, 13, 13, 255, 13, 13, 13, 13,
        13, 13, 13, 13, 13, 13, 13, 13, 13,
        13, 13, 13, 13, 255, 13, 13, 13, 13,
        13, 13, 13, 255, 255, 255, 13, 13, 13,
        13, 13, 13, 13, 13, 13, 13, 13, 13
      ]
    }
  },
  "mass": 20,
  "fuse": { "ticks": 1620, "variance": 0 },
  "stain": [
    156, 156, 156, 255, 140, 140, 140, 255, 132, 132, 132, 255, 132, 132, 132, 255, 132, 132, 132, 255, 140, 140, 140, 255, 148, 148, 148, 255, 148, 148, 148, 255, 116, 116, 116, 255,
    144, 144, 144, 255, 124, 124, 124, 255, 160, 152, 40, 255, 108, 108, 108, 255, 92, 92, 92, 255, 100, 100, 100, 255, 200, 192, 48, 255, 116, 116, 116, 255, 84, 84, 84, 255,
    132, 132, 132, 255, 120, 116, 28, 255, 160, 152, 40, 255, 200, 192, 48, 255, 92, 92, 92, 255, 200, 192, 48, 255, 160, 152, 40, 255, 200, 192, 48, 255, 84, 84, 84, 255,
    140, 140, 140, 255, 108, 108, 108, 255, 108, 108, 108, 255, 100, 100, 100, 255, 100, 100, 100, 255, 100, 100, 100, 255, 108, 108, 108, 255, 108, 108, 108, 255, 84, 84, 84, 255,
    148, 148, 148, 255, 108, 108, 108, 255, 92, 92, 92, 255, 92, 92, 92, 255, 160, 152, 40, 255, 100, 100, 100, 255, 108, 108, 108, 255, 108, 108, 108, 255, 84, 84, 84, 255,
    148, 148, 148, 255, 108, 108, 108, 255, 100, 100, 100, 255, 108, 108, 108, 255, 108, 108, 108, 255, 108, 108, 108, 255, 100, 100, 100, 255, 100, 100, 100, 255, 76, 76, 76, 255,
    140, 140, 140, 255, 124, 124, 124, 255, 108, 108, 108, 255, 100, 100, 100, 255, 200, 192, 48, 255, 100, 100, 100, 255, 100, 100, 100, 255, 108, 108, 108, 255, 76, 76, 76, 255,
    144, 144, 144, 255, 100, 100, 100, 255, 92, 92, 92, 255, 200, 192, 48, 255, 160, 152, 40, 255, 120, 116, 28, 255, 100, 100, 100, 255, 92, 92, 92, 255, 72, 72, 72, 255,
    100, 100, 100, 255, 76, 76, 76, 255, 84, 84, 84, 255, 92, 92, 92, 255, 100, 100, 100, 255, 84, 84, 84, 255, 76, 76, 76, 255, 76, 76, 76, 255, 76, 76, 76, 255
  ],
  "on": {
    // Defused. `destroy_self` runs the authored death (`death` defaults to
    // `shower`), which an omitted `hp` would otherwise have made unreachable.
    "collide_worm": [
      { "destroy_self": {} }
    ],
    // Nobody came. The chain below is verbatim the old `gadget_core` fuse.
    "fuse": [
      "gadget_explosion",
      { "emit": { "type": "gadget_detonator", "count": 1, "velocity": "radial", "wl_free_step": true } },
      { "remove": {} }
    ]
  }
}
